# ==========================================
# TigerGraph Credentials (Docker or Savanna)
# ==========================================
TG_HOST=http://localhost:9000
TG_USERNAME=tigergraph
TG_PASSWORD=tigergraph
TG_SECRET=
TG_GRAPH=SpikeGraph

# ==========================================
# Database (Turso / libSQL)
# ==========================================
TURSO_DATABASE_URL=file:db/interlock.db
TURSO_AUTH_TOKEN=

# ==========================================
# LLM Provider API Key
# ==========================================
# This project runs entirely on free-tier LLM access. Get a free API key
# from Groq (https://console.groq.com/keys) and set it below.
GROQ_API_KEY=

# ==========================================
# Application Settings
# ==========================================
DEMO_MODE=false
LLM_OFFLINE=false
LLM_SPEND_CAP_USD=25

# ==========================================
# Frontend Dashboard
# ==========================================
NEXT_PUBLIC_API_URL=http://localhost:8000
