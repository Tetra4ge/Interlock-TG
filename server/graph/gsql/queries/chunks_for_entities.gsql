CREATE QUERY chunks_for_entities(SET<VERTEX> entities, INT max_limit = 10) FOR GRAPH Interlock SYNTAX v2 {
  Start = entities;

  // MENTIONS edges go from Chunk to Entity, so reaching chunks from an entity is reverse.
  Chunks = SELECT c FROM Start:s -(<MENTIONS:e)- Chunk:c LIMIT max_limit;

  PRINT Chunks;
}
