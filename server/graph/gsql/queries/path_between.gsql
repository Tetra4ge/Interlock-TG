CREATE QUERY path_between(VERTEX source, VERTEX dst_v, INT max_hops = 3) FOR GRAPH Interlock SYNTAX v2 {
  // Bounded BFS shortest path
  OrAccum @visited;
  ListAccum<VERTEX> @path;
  ListAccum<VERTEX> @@result;
  INT hops_left = max_hops;

  Start = {source};
  Start = SELECT s FROM Start:s ACCUM s.@visited = true, s.@path += s;

  WHILE Start.size() > 0 AND hops_left > 0 DO
    Start = SELECT t FROM Start:s -(:e)- :t
            WHERE t.@visited == false
            ACCUM t.@visited = true,
                  t.@path = s.@path + [t]
            POST-ACCUM
                  IF t == dst_v THEN
                     @@result += t.@path
                  END;
    hops_left = hops_left - 1;
  END;

  PRINT @@result;
}
