CREATE VERTEX Company (PRIMARY_ID id STRING, name STRING, cin STRING, aliases_text STRING, sector STRING, in_dataset BOOL) WITH PRIMARY_ID_AS_ATTRIBUTE="true"
CREATE VERTEX Person (PRIMARY_ID id STRING, name STRING, din STRING, aliases_text STRING) WITH PRIMARY_ID_AS_ATTRIBUTE="true"
CREATE VERTEX AuditFirm (PRIMARY_ID id STRING, name STRING, frn STRING, aliases_text STRING) WITH PRIMARY_ID_AS_ATTRIBUTE="true"
CREATE VERTEX Sector (PRIMARY_ID id STRING) WITH PRIMARY_ID_AS_ATTRIBUTE="true"
CREATE VERTEX Document (PRIMARY_ID id STRING) WITH PRIMARY_ID_AS_ATTRIBUTE="true"
CREATE VERTEX Chunk (PRIMARY_ID id STRING, doc_id STRING, text STRING, section STRING, page_start INT, page_end INT, fiscal_year STRING, company_id STRING) WITH PRIMARY_ID_AS_ATTRIBUTE="true"
CREATE VERTEX RegulatoryAction (PRIMARY_ID id STRING) WITH PRIMARY_ID_AS_ATTRIBUTE="true"
CREATE VERTEX RelatedPartyTxn (PRIMARY_ID id STRING, amount_inr DOUBLE, nature STRING, relationship STRING, fiscal_year STRING) WITH PRIMARY_ID_AS_ATTRIBUTE="true"

CREATE DIRECTED EDGE IN_SECTOR (FROM Company, TO Sector)
CREATE DIRECTED EDGE DIRECTOR_OF (FROM Person, TO Company, edge_id STRING, role STRING, independent BOOL, start_date STRING, end_date STRING, fiscal_year STRING, doc_id STRING, page INT, quote STRING, run_id STRING) WITH REVERSE_EDGE="HAS_DIRECTOR"
CREATE DIRECTED EDGE PARTY_TO (FROM Company|Person, TO RelatedPartyTxn, side STRING, doc_id STRING, page INT, quote STRING, run_id STRING, edge_id STRING)
CREATE DIRECTED EDGE HOLDS_STAKE (FROM Company, TO Company, pledged_pct DOUBLE)
CREATE DIRECTED EDGE SUBSIDIARY_OF (FROM Company, TO Company)
CREATE DIRECTED EDGE AUDITED_BY (FROM Company, TO AuditFirm, edge_id STRING, fiscal_year STRING, doc_id STRING, page INT, quote STRING, run_id STRING) WITH REVERSE_EDGE="AUDITS"
CREATE DIRECTED EDGE NAMED_IN (FROM Company|Person, TO RegulatoryAction)
CREATE DIRECTED EDGE HAS_CHUNK (FROM Document, TO Chunk)
CREATE DIRECTED EDGE MENTIONS (FROM Chunk, TO Company|Person|AuditFirm)

CREATE GRAPH Interlock (*)
